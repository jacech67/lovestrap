<ui:UiPage x:Class="Lovestrap.UI.Elements.Settings.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Lovestrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Lovestrap.Resources"
      xmlns:controls="clr-namespace:Lovestrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      Title="FastFlagsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,16" Text="{x:Static resources:Strings.Menu_FastFlags_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- Editor + manager controls at the top -->
        <ui:CardAction Icon="Wand24" Command="{Binding OpenFastFlagEditorCommand}" Visibility="{Binding CanShowFastFlagEditor}">
            <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_FastFlags_Editor_Description}" Padding="0,0,16,0"  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ui:CardAction>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Description}">
            <ui:ToggleSwitch IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:InfoBar
            Margin="0,12,0,4"
            Padding="10"
            Title="Account risk warning"
            Message="Roblox only permits selected local FastFlags. Unapproved flags may be ignored and attempts to bypass Roblox restrictions can put your account at risk. Use custom FastFlags at your own caution."
            Severity="Warning"
            IsOpen="True"
            IsClosable="False" />

        <controls:OptionControl
            Header="Enable Fast Flag Injector"
            Description="Watches Modifications\\ClientSettings\\InjectedFlags.json, saves every external edit, and deploys it without closing or restarting Roblox. Startup-only flags apply on a later launch.">
            <ui:ToggleSwitch IsChecked="{Binding EnableFastFlagInjector, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}">
            <ui:ToggleSwitch IsChecked="{Binding ResetConfiguration, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="{x:Static resources:Strings.Common_Presets}" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />

        <!-- ================= Geometry ================= -->
        <TextBlock Text="Geometry" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl
            Header="Texture and mesh preset"
            Description="Choose the graphics preset that Lovestrap queues for the next Roblox launch.">
            <ComboBox
                Margin="5,0,0,0"
                Padding="10,5,10,5"
                Width="200"
                ItemsSource="{Binding TextureMeshModes, Mode=OneTime}"
                SelectedItem="{Binding SelectedTextureMeshMode, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:InfoBar
            Margin="0,8,0,4"
            Padding="10"
            Title="Optional Fleasion companion"
            Message="Blurry and ZeroTextures use the official Fleasion asset proxy and the supplied replacement IDs. It needs an administrator prompt because it configures a local proxy. Lovestrap never closes or restarts Roblox; if Roblox is open, the change stays queued for the next launch."
            Severity="Warning"
            IsOpen="True"
            IsClosable="False" />

        <TextBlock Margin="4,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Normal: original assets • Blurry: replaces 7658055825 with the bundled local blurry PNG • ZeroTextures: 7658055825 → 15403233827. Press Save before launching Roblox." />

        <!-- ================= Rendering and Graphics ================= -->
        <TextBlock Text="Rendering and Graphics" FontSize="16" FontWeight="Medium" Margin="0,20,0,0" />

        <controls:OptionControl
            Header="RTX Mode (maximum quality)"
            Description="Queues Lovestrap's highest-quality Roblox preset for the next launch: full textures and meshes, 4x anti-aliasing, maximum render quality, grass and baked shadows.">
            <ui:ToggleSwitch IsChecked="{Binding RtxMode, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:InfoBar
            Margin="0,8,0,4"
            Padding="10"
            Title="RTX-like quality preset"
            Message="This makes Roblox look as good as its permitted local quality controls allow. It is not real ray tracing and cannot add Minecraft-style shader effects such as custom reflections or new lighting. It applies on the next launch and never closes or restarts Roblox."
            Severity="Informational"
            IsOpen="True"
            IsClosable="False" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}" Text="{Binding SelectedMSAALevel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Description}"
            HelpLink="https://bloxstraplabs.com/wiki/features/engine-settings/#preserving-rendering-quality">
            <ui:ToggleSwitch IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="FRM Quality Override"
            Description="Choose the FRM (render) quality level Roblox should use.">
            <ui:ToggleSwitch IsChecked="{Binding FRMQualityEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <ui:Card Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Lowest quality" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Slider Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Minimum="1" Maximum="21" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding FRMQualityEnabled}" Value="{Binding FRMQualityLevel, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Highest quality" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Border Grid.Column="3" Margin="12,0,0,0" MinWidth="28" Padding="6,2" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock HorizontalAlignment="Center" Text="{Binding FRMQualityLevel, Mode=OneWay}" />
                </Border>
            </Grid>
        </ui:Card>

        <controls:OptionControl
            Header="Rendering mode"
            Description="Choose which graphics API Roblox should use.">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding RenderingModes, Mode=OneTime}" Text="{Binding SelectedRenderingMode, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="Texture quality">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}" Text="{Binding SelectedTextureQuality, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="Gray Sky"
            Description="Changes the game's sky to a solid gray color. Won't work in games with a custom skybox added by the developer.">
            <ui:ToggleSwitch IsChecked="{Binding GraySky, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Disable Grass"
            Description="Removes terrain grass decoration for better performance.">
            <ui:ToggleSwitch IsChecked="{Binding DisableGrass, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Pause Voxelizer"
            Description="Disables baked shadows to improve performance, but may cause lighting issues in some games.">
            <ui:ToggleSwitch IsChecked="{Binding PauseVoxelizer, Mode=TwoWay}" />
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
