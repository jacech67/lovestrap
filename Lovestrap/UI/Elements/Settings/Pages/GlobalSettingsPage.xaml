<ui:UiPage x:Class="Lovestrap.UI.Elements.Settings.Pages.GlobalSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Lovestrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="GlobalSettingsPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,16" Text="Set in-game Roblox settings from the Lovestrap menu." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl
            Header="Set as Read-Only"
            Description="Prevent Roblox from overriding these global settings.">
            <ui:ToggleSwitch IsChecked="{Binding SetReadOnly, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Presets" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />

        <TextBlock Text="Rendering and Graphics" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl
            Header="Graphics Quality"
            Description="Set the graphics quality of your game.">
            <StackPanel Orientation="Horizontal">
                <Slider Width="220" VerticalAlignment="Center" Minimum="1" Maximum="21" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GraphicsQuality, Mode=TwoWay}" />
                <Border Margin="12,0,0,0" MinWidth="28" Padding="6,2" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock HorizontalAlignment="Center" Text="{Binding GraphicsQuality, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl
            Header="Framerate Limit"
            Description="Unlock the framerate limit for Roblox. Going above 240 FPS is not recommended.">
            <TextBox Width="140" Text="{Binding FramerateLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ValidateUInt32" />
        </controls:OptionControl>

        <TextBlock Text="User Interface and Layout" FontSize="16" FontWeight="Medium" Margin="0,20,0,0" />

        <controls:OptionControl
            Header="Transparency"
            Description="Custom transparency for UI elements.">
            <StackPanel Orientation="Horizontal">
                <Slider Width="220" VerticalAlignment="Center" Minimum="0" Maximum="1" TickFrequency="0.1" Value="{Binding Transparency, Mode=TwoWay}" />
                <Border Margin="12,0,0,0" MinWidth="28" Padding="6,2" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock HorizontalAlignment="Center" Text="{Binding Transparency, Mode=OneWay, StringFormat={}{0:0.0}}" />
                </Border>
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl
            Header="Reduced Motion"
            Description="Removes the animation on the escape menu.">
            <ui:ToggleSwitch IsChecked="{Binding ReducedMotion, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Font Size"
            Description="Choose how large the font should appear.">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding FontSizes, Mode=OneTime}" SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Other" FontSize="16" FontWeight="Medium" Margin="0,20,0,0" />

        <controls:OptionControl
            Header="Mouse Sensitivity"
            Description="Change how fast the camera will move in-game.">
            <TextBox Width="140" Text="{Binding MouseSensitivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="VR Enabled">
            <ui:ToggleSwitch IsChecked="{Binding VREnabled, Mode=TwoWay}" />
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
